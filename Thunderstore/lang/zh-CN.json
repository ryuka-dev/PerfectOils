    },
    {
      "key": "entry.Traits.RemoveFasterDurabilityLoss.description",
      "value": "移除会加快每发耐久消耗的魔油效果。降低耐久消耗的效果仍会生效。"
    },
    {
      "key": "entry.Traits.RemoveSelfDamage.name",
      "value": "移除自身伤害"
    },
    {
      "key": "entry.Traits.RemoveSelfDamage.description",
      "value": "移除会在开火时伤害持有者的魔油效果。"
    },
    {
      "key": "entry.Traits.RemoveNegativeProjectileForce.name",
      "value": "移除弹丸力度降低"
    },
    {
      "key": "entry.Traits.RemoveNegativeProjectileForce.description",
      "value": "仅移除降低发射力度的修改。提高力度的正面效果仍会生效。"
