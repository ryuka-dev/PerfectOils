    {
      "key": "entry.Traits.RemoveMoreSpread.name",
      "value": "移除散布增加"
    },
    {
      "key": "entry.Traits.RemoveMoreSpread.description",
      "value": "移除会扩大散布的魔油效果。提高精准度的效果仍会生效。"
