    {
      "key": "entry.Traits.RemoveNegativeMaxDurability.name",
      "value": "移除负面最大耐久"
    },
    {
      "key": "entry.Traits.RemoveNegativeMaxDurability.description",
      "value": "仅移除降低最大耐久上限的修改。提高最大耐久的正面效果仍会生效。"
    },
    {
      "key": "entry.Traits.RemoveMoreRecoil.name",
      "value": "移除后坐力增加"
    },
    {
      "key": "entry.Traits.RemoveMoreRecoil.description",
      "value": "移除会增加后坐力的魔油效果。降低后坐力的效果仍会生效。"
