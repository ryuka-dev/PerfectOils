    {
      "key": "entry.Traits.RemoveNegativeReloadSpeed.name",
      "value": "移除装填变慢"
    },
    {
      "key": "entry.Traits.RemoveNegativeReloadSpeed.description",
      "value": "仅移除减慢装填的修改。加快装填的效果仍会生效。"
    },
    {
      "key": "entry.Traits.RemoveFasterDurabilityLoss.name",
