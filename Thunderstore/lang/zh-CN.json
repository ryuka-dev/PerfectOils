{
  "entries": [
    {
      "key": "plugin.name",
      "value": "Perfect Oils"
    },
    {
      "key": "plugin.description",
      "value": "按需移除武器魔油的负面效果，保留正面效果，并用删除线标出已被移除的说明。"
    },
    {
      "key": "section.General",
      "value": "常规"
    },
    {
