      "value": "显示"
    },
    {
      "key": "section.Debug",
      "value": "调试"
    },
    {
      "key": "entry.General.Enabled.name",
      "value": "启用 Mod"
    },
    {
      "key": "entry.General.Enabled.description",
      "value": "启用 Perfect Oils。可以在“负面效果”分区中分别选择要移除的效果。"
    },
    {
      "key": "entry.General.RemoveExtraDurabilityCost.name",
      "value": "移除额外耐久消耗"
    },
    {
      "key": "entry.General.RemoveExtraDurabilityCost.description",
      "value": "移除魔油额外造成的武器耐久消耗。此选项独立于其他负面效果。"
    },
    {
      "key": "entry.Display.ShowRemovedTraitsWithStrikethrough.name",
      "value": "为已移除效果显示删除线"
    },
    {
      "key": "entry.Display.ShowRemovedTraitsWithStrikethrough.description",
      "value": "保留魔油的原版说明，并为当前被本 Mod 移除的效果添加删除线。"
    },
    {
      "key": "entry.Debug.DetailedLogging.name",
      "value": "详细日志"
    },
    {
      "key": "entry.Debug.DetailedLogging.description",
      "value": "记录每条被分类的魔油修改和悬浮信息行。正常游玩时建议关闭。"
    },
    {
      "key": "entry.Traits.RemoveDisableAiming.name",
      "value": "移除禁用瞄准"
    },
    {
      "key": "entry.Traits.RemoveDisableAiming.description",
      "value": "移除会禁止开镜瞄准的魔油效果。"
    },
    {
